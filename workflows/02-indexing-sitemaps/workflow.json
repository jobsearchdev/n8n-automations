    {
      "parameters": {
        "jsCode": "const items = $input.all();\nlet result = [];\n\nfor (const item of items) {\n  const urls = item.json.urlset?.url ?? [];\n  const arr = Array.isArray(urls) ? urls : [urls];\n\n  for (const u of arr) {\n    result.push({\n      json: {\n        loc: u.loc ?? null,\n        lastmod: u.lastmod ?? null,\n      }\n    });\n  }\n}\n\nreturn result;"
      },
