    {
      "parameters": {
        "jsCode": "const norm = (u) => (u || \"\").trim().replace(/\\/+$/, \"/\");\n\nconst all = $input.all().map(i => i.json);\n\nconst dbItems = [];\nconst sitemapItems = [];\n\n// Розділяємо потоки\nfor (const r of all) {\n  if (r.id || r.createdAt || r.updatedAt) dbItems.push(r);\n  else sitemapItems.push(r);\n}\n\n// Map бази\nconst dbMap = new Map();\nfor (const r of dbItems) {\n  const loc = norm(r.loc || r[\"місце\"]);\n  const lastmod = r.lastmod || r[\"останнмод\"];\n  if (!loc || !lastmod) continue;\n  dbMap.set(loc, new Date(lastmod));\n}\n\n// Результат\nconst result = [];\n\nfor (const r of sitemapItems) {\n  const loc = norm(r.loc);\n  const lastmod = r.lastmod;\n  if (!loc || !lastmod) continue;\n\n  const sitemapDate = new Date(lastmod);\n  const dbDate = dbMap.get(loc);\n\n  // 1️⃣ Немає в базі\n  if (!dbDate) {\n    result.push({\n      json: { loc, lastmod, action: \"insert\" }\n    });\n  }\n\n  // 2️⃣ Є в базі, але дата новіша\n  else if (sitemapDate > dbDate) {\n    result.push({\n      json: { loc, lastmod, action: \"update\" }\n    });\n  }\n}\n\nreturn result;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        4144,
        496
